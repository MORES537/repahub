# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# WalletConnect / Reown
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Hedera network
VITE_HEDERA_NETWORK=mainnet
VITE_HEDERA_TREASURY_ACCOUNT_ID=0.0.xxxxxxx

# RC Token sale contract
VITE_RC_SALE_CONTRACT_EVM_ADDRESS=0xYourRcSaleContractEvmAddress
VITE_RC_TOKEN_ID=0.0.xxxxxxx
VITE_RC_SALE_CONTRACT_GAS=450000
VITE_TOPUP_MIN_HBAR=0.01
VITE_TOPUP_MAX_HBAR=25

# RepaHub Music NFT contract (Hedera Mainnet)
VITE_MUSIC_NFT_CONTRACT_EVM=0xYourMusicNftEvmAddress
VITE_MUSIC_NFT_CONTRACT_ID=0.0.xxxxxxx

# HTS NFT token (minted by the music NFT contract)
VITE_HTS_NFT_TOKEN_ID=0.0.xxxxxxx
VITE_HTS_NFT_TOKEN_EVM=0x0000000000000000000000000000000000000000

# Pinata IPFS — get your JWT at https://app.pinata.cloud/developers/api-keys
# Use a key scoped to Files:Write only
VITE_PINATA_JWT=your_pinata_jwt_here
VITE_PINATA_GATEWAY=https://your-subdomain.mypinata.cloud
